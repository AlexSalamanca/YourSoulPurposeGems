# Copy to .env.local for local dev, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real values.

# ---------------------------------------------------------------------------
# Email (order notifications)
# ---------------------------------------------------------------------------

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where order notifications are delivered.
ORDER_EMAIL_TO=yoursoulpurposegems@gmail.com

# Optional. Must be a Resend-verified sender once you have your own domain.
# Until then leave this unset — the code falls back to onboarding@resend.dev,
# which can only deliver to the address that owns the Resend account.
# ORDER_EMAIL_FROM=Your Soul Purpose Gems <orders@yoursoulpurposegems.com>

# ---------------------------------------------------------------------------
# Square (card payments)
#
# This is the same Square account used at the markets, so online sales land in
# the same dashboard, deposits and tax reports as in-person ones.
#
# Everything below exists TWICE in Square: once for sandbox, once for
# production. The values are not interchangeable, and mixing them is the most
# common reason a webhook signature fails.
# ---------------------------------------------------------------------------

# Which set of Square credentials the code talks to.
# ONLY the exact string 'production' takes real money. Anything else — unset,
# empty, misspelled — uses sandbox, which is the safe way round to be wrong.
SQUARE_ENVIRONMENT=sandbox

# Required. https://developer.squareup.com/apps -> your app -> Credentials.
# Sandbox and production have separate tokens; make sure this one matches
# SQUARE_ENVIRONMENT above.
SQUARE_ACCESS_TOKEN=EAAAxxxxxxxxxxxxxxxxxxxxxxxx

# Required. Which location the sale is booked against — the same list your
# market locations appear in. Find it under Locations in the developer
# dashboard, or via GET /v2/locations.
SQUARE_LOCATION_ID=Lxxxxxxxxxxxxx

# Required for api/webhook.js, which is what turns a paid checkout into an
# order email. Create the subscription at
#   https://developer.squareup.com/apps -> your app -> Webhooks -> Subscriptions
#   URL     https://www.yoursoulpurposegems.com/api/webhook
#   Events  payment.updated
# Square shows the signature key once the subscription exists.
SQUARE_WEBHOOK_SIGNATURE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Required, and must match the URL registered above CHARACTER FOR CHARACTER.
# Square signs this string together with the request body, so a trailing slash
# or an http/https mismatch makes every event fail verification.
SQUARE_WEBHOOK_URL=https://www.yoursoulpurposegems.com/api/webhook

# Optional but recommended. The origin Square returns the customer to. Without
# it the code falls back to the request's Origin header, which is fine in
# production but wrong when a preview deployment is being tested.
# SITE_URL=https://www.yoursoulpurposegems.com
